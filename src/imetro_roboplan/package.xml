<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>imetro_roboplan</name>
  <version>0.1.0</version>
  <description>
    iMETRO specific abstractions around the RoboPlan motion planning library.
  </description>

  <maintainer email="sebastian.a.castrofernandez@nasa.gov">Sebastian Castro</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <!-- RoboPlan itself comes from the `roboplan-python` conda package, or a source build. -->
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>interactive_markers</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>imetro_roboplan_msgs</exec_depend>
  <exec_depend>roboplan_ros_cpp</exec_depend>
  <exec_depend>roboplan_ros_py</exec_depend>
  <exec_depend>roboplan_ros_visualization</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
