<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>imetro_roboplan_behaviors</name>
  <version>0.1.0</version>
  <description>
    imetro_behavior behavior tree nodes and subtrees for use with the RoboPlan motion planning library.
  </description>

  <maintainer email="sebastian.a.castrofernandez@nasa.gov">Sebastian Castro</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>control_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>imetro_behavior</exec_depend>
  <exec_depend>py_trees_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>imetro_roboplan_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
